# Docker Compose — PostgreSQL e Redis (opcional, copie para .env para sobrescrever).
# Postgres e Redis usam portas não padrão (5433 e 6380) para não conflitar com instâncias em 5432/6379.
# Database (genérico)
DB_CONTAINER=postgres-lab
DB_PORT=5433
DB_USER=lab_user
DB_PASSWORD=dev_labs123
DB_DATABASE=doevida_db

# Configurações do Redis
REDIS_HOST=localhost
REDIS_PORT=6380
